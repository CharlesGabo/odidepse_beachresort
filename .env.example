DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=odidepse_db
DB_USER=odidepse_app
DB_PASSWORD=replace_with_a_strong_local_password

# Email is disabled until you configure and test Gmail SMTP. Never use your Google password.
APP_BASE_URL=
MAIL_ENABLED=0
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Odidepse Beach Resort"
MAIL_REPLY_TO_ADDRESS=
MAIL_ADMIN_RECIPIENTS=
# Optional: redirect ALL mail to this test inbox during local/preview testing.
MAIL_TEST_RECIPIENT=

# Optional server-side AI. Leave the key empty for rule-based Website Chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Meta/Facebook server-side integration. Never use these in VITE_* variables.
META_APP_ID=replace_with_your_meta_app_id
META_APP_SECRET=replace_with_your_meta_app_secret
META_PAGE_ID=replace_with_the_connected_facebook_page_id
META_PAGE_ACCESS_TOKEN=replace_with_the_page_access_token
META_WEBHOOK_VERIFY_TOKEN=replace_with_a_random_64_character_value
META_GRAPH_API_VERSION=replace_with_the_version_shown_in_your_meta_app
