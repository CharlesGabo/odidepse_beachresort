DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=odidepse_db
DB_USER=odidepse_app
DB_PASSWORD=replace_with_a_strong_local_password

# Meta/Facebook server-side integration. Never use these in VITE_* variables.
META_APP_ID=replace_with_your_meta_app_id
META_APP_SECRET=replace_with_your_meta_app_secret
META_PAGE_ID=replace_with_the_connected_facebook_page_id
META_PAGE_ACCESS_TOKEN=replace_with_the_page_access_token
META_WEBHOOK_VERIFY_TOKEN=replace_with_a_random_64_character_value
META_GRAPH_API_VERSION=replace_with_the_version_shown_in_your_meta_app
